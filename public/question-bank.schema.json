{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuizLab bank v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "title",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "pattern": "\\S"
    },
    "description": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "kind": {
      "enum": [
        "bank",
        "paper"
      ]
    },
    "instructions": {
      "$ref": "#/$defs/text"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "context": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text",
        "answer",
        "explanation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "type": {
          "enum": [
            "single",
            "multiple",
            "true-false",
            "short",
            "table"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "topic": {
          "$ref": "#/$defs/text"
        },
        "difficulty": {
          "$ref": "#/$defs/text"
        },
        "hint": {
          "$ref": "#/$defs/text"
        },
        "answer": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "marks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "rubric": {
          "$ref": "#/$defs/text"
        },
        "sectionId": {
          "$ref": "#/$defs/text"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "table": {
          "type": "object",
          "required": [
            "rows",
            "columns"
          ],
          "properties": {
            "rows": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "$comment": "The importer additionally checks that answer.length equals rows.length × columns.length; standard JSON Schema cannot express this cross-field calculation."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single",
                  "multiple"
                ]
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "single",
                  "short",
                  "true-false"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "maxItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "true-false"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "items": {
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            }
          },
          "then": {
            "required": [
              "table"
            ]
          },
          "else": {
            "properties": {
              "answer": {
                "uniqueItems": true
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "const": "paper"
          }
        }
      },
      "then": {
        "required": [
          "sections"
        ],
        "properties": {
          "sections": {
            "minItems": 1
          },
          "questions": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/question"
                },
                {
                  "required": [
                    "sectionId"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ]
}